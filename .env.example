# Base de datos
DB_USER=feedbackuser
DB_PASSWORD=feedbackpass
DB_NAME=feedbackboard
DB_PORT=3002

# Local (Prisma CLI, migraciones desde tu máquina)
DATABASE_URL=postgresql://feedbackuser:feedbackpass@localhost:3002/feedbackboard?schema=public
# Docker (NestJS dentro del container)
DATABASE_URL_DOCKER=postgresql://${DB_USER}:${DB_PASSWORD}@postgres:5432/${DB_NAME}?schema=public

# Redis
REDIS_PORT=3003

# Mailpit
MAILPIT_UI_PORT=3004
MAILPIT_SMTP_PORT=3005
SMTP_FROM=feedback@feedbackboard.dev
SMTP_SECURE=false
SMTP_IGNORE_TLS=true

# API
API_PORT=3000
JWT_SECRET=#token secreto
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=#token secreto
REFRESH_TOKEN_EXPIRE_IN=7d
NODE_ENV=development

# Web
WEB_PORT=3001
VITE_API_URL=http://localhost:3000
VITE_PROXY_TARGET=http://fb_api:3000  # nombre del servicio Docker
WEB_URL=http://localhost:3001